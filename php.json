{
	"output": {
		"prefix": "eo",
		"body": "echo ${0:0};",
		"description": "終端機輸出"
	},
	"output and format": {
		"prefix": "pf",
		"body": "printf(\"${0:%d}\",${1:0});",
		"description": "終端機格式化輸出"
	},
	"input": {
		"prefix": "gs",
		"body": "fgets(STDIN);",
		"description": "終端機輸入"
	},
	"remove escape character": {
		"prefix": "tm",
		"body": "trim(${0:0});",
		"description": "去除跳脫字元"
	},
	"define": {
		"prefix": "df",
		"body": "define(\"${1:PI}\", ${0:3.1415926});",
		"description": "常數"
	},
	"get type": {
		"prefix": "gp",
		"body": "gettype(${0:7});",
		"description": "獲取類型"
	},
	"if...else": {
		"prefix": "ie",
		"body": [
			"if (${1:true}) {",
			"    $2",
			"}",
			"else {",
			"    $0",
			"}"
		],
		"description": "if...else結構"
	},
	"if...elseif...else": {
		"prefix": "ef",
		"body": [
			"if (${1:false}) {",
			"    $2",
			"}",
			"elseif (${3:true}) {",
			"    $4",
			"}",
			"else {",
			"    $0",
			"}"
		],
		"description": "if...elseif...else結構"
	},
	"switch": {
		"prefix": "sh",
		"body": [
			"switch (${1:\\$key}) {",
			"    case ${2:'value'}:",
			"        $3",
			"        break;",
			"",
			"    default:",
			"        $0",
			"        break;",
			"}"
		],
		"description": "switch...case結構"
	},
	"match": {
		"prefix": "mh",
		"body": [
			"match (${1:\\$key}) {",
			"    ${2:1} => ${3:87},",
			"    default => ${0:0}",
			"};"
		],
		"description": "match結構"
	},
	"for...loop": {
		"prefix": "fp",
		"body": [
			"for (${1:\\$index} = ${2:0}; ${1:\\$index} < ${3:10}; ${1:\\$index}++) {",
			"    $0",
			"}"
		],
		"description": "for迴圈"
	},
	"foreach": {
		"prefix": "fe",
		"body": [
			"foreach(${1:\\$var} as ${2:\\$a}) {",
			"   $0",
			"}"
		],
		"description": "foreach迴圈"
	},
	"while": {
		"prefix": "we",
		"body": [
			"while (${1:true}) {",
			"    $0",
			"}"
		],
		"description": "while迴圈"
	},
	"do...while": {
		"prefix": "dw",
		"body": [
			"do {",
			"    $1",
			"} while (${0:false});"
		],
		"description": "do...while迴圈"
	},
	"function": {
		"prefix": "fun",
		"body": [
			"function ${1:name}(${2:\\$params}) {",
			"    $0",
			"}"
		],
		"description": "函數"
	},
	"arrow function": {
		"prefix": "af",
		"body": [
			"fn(${1:\\$x}) => ${0:\\$x};",
		],
		"description": "箭頭函數"
	}
}